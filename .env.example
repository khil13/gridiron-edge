# Data source: "mock" (bundled dataset, no network) or "live"
VITE_DATA_SOURCE=mock

# Live scores/standings come from ESPN's public scoreboard endpoint.
# No key required. Set to "false" to disable live score fetching.
VITE_ENABLE_ESPN=true

# Odds come from The Odds API (https://the-odds-api.com). Free tier works.
# Leave blank to keep using simulated market prices.
VITE_ODDS_API_KEY=

# Comma-separated sportsbook keys to request from The Odds API.
VITE_ODDS_BOOKS=draftkings,fanduel,betmgm,williamhill_us,pinnacle
